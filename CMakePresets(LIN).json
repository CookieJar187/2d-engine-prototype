{
    "version": 3,
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux Development",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_MAKE_PROGRAM": "/usr/bin/make",
                "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/Desktop/tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ]
}